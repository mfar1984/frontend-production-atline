4:["$","div",null,{"className":"fq-answer","children":["$","p",null,{"children":"Our headquarters is at Kelana Square, Petaling Jaya, Selangor. We operate nationwide, with completed projects in Selangor, Kuala Lumpur, Perak, Johor, Sabah, Sarawak, and other Malaysian states. We are currently expanding our footprint in East Malaysia."}]}]
5:["$","details","2",{"className":"fq-detail","children":[["$","summary",null,{"className":"fq-summary","children":[["$","div",null,{"className":"fq-q-num","children":"03"}],["$","div",null,{"className":"fq-q-text","children":"How long has ATLINE been in business?"}],["$","div",null,{"className":"fq-chevron","children":["$","i",null,{"className":"bi bi-chevron-down"}]}]]}],["$","div",null,{"className":"fq-answer","children":["$","p",null,{"children":"ATLINE (originally registered as KF Legacy Resources Sdn Bhd) was established in November 2015. With over 11 years of operation and a combined team experience exceeding 100 years, we have built a strong reputation serving Politeknik Malaysia, Kolej Komuniti, government ministries, and private corporations."}]}]]}]
6:["$","details","3",{"className":"fq-detail","children":[["$","summary",null,{"className":"fq-summary","children":[["$","div",null,{"className":"fq-q-num","children":"04"}],["$","div",null,{"className":"fq-q-text","children":"Is ATLINE a government-registered company?"}],["$","div",null,{"className":"fq-chevron","children":["$","i",null,{"className":"bi bi-chevron-down"}]}]]}],["$","div",null,{"className":"fq-answer","children":["$","p",null,{"children":"Yes. ATLINE SDN BHD is registered with Suruhanjaya Syarikat Malaysia (SSM) under registration number 201503318537 (002488335-X), valid until 14 November 2029. We are also registered for government procurement through the appropriate Ministry of Finance panels."}]}]]}]
7:["$","div","Services",{"id":"fq-services","className":"fq-cat-section","children":[["$","div",null,{"className":"fq-cat-header fq-services","children":[["$","i",null,{"className":"bi bi-gear"}],["$","h2",null,{"children":"Services"}],["$","span",null,{"children":[5," questions"]}]]}],["$","div",null,{"className":"fq-accordion","children":[["$","details","0",{"className":"fq-detail","children":[["$","summary",null,{"className":"fq-summary","children":[["$","div",null,{"className":"fq-q-num","children":"01"}],["$","div",null,{"className":"fq-q-text","children":"What structured cabling standards do you comply with?"}],["$","div",null,{"className":"fq-chevron","children":["$","i",null,{"className":"bi bi-chevron-down"}]}]]}],["$","div",null,{"className":"fq-answer","children":["$","p",null,{"children":"All our structured cabling installations comply with TIA/EIA-568-C.2 (copper) and TIA-568-C.3 (optical fibre) international standards. We also follow IEC 11801 where required. Every completed cabling run is tested and certified using Fluke Networks cable testers, and clients receive full test reports upon project completion."}]}]]}],["$","details","1",{"className":"fq-detail","children":[["$","summary",null,{"className":"fq-summary","children":[["$","div",null,{"className":"fq-q-num","children":"02"}],["$","div",null,{"className":"fq-q-text","children":"Which networking brands does ATLINE supply and install?"}],["$","div",null,{"className":"fq-chevron","children":["$","i",null,{"className":"bi bi-chevron-down"}]}]]}],["$","div",null,{"className":"fq-answer","children":["$","p",null,{"children":"We supply and install products from Cisco, Aruba / HPE, Fortinet, Ubiquiti, MikroTik, Huawei, D-Link, Zyxel, Palo Alto Networks, Sophos, and more. For structured cabling, we use Panduit, AMP Netconnect, Belden, and HellermannTyton products. Brand selection is guided by your project requirements, budget, and existing infrastructure."}]}]]}],["$","details","2",{"className":"fq-detail","children":[["$","summary",null,{"className":"fq-summary","children":[["$","div",null,{"className":"fq-q-num","children":"03"}],["$","div",null,{"className":"fq-q-text","children":"Do you provide network security services?"}],["$","div",null,{"className":"fq-chevron","children":["$","i",null,{"className":"bi bi-chevron-down"}]}]]}],["$","div",null,{"className":"fq-answer","children":["$","p",null,{"children":"Yes. Our security services include next-generation firewall (NGFW) deployment and configuration, unified threat management (UTM) solutions, VPN design and implementation, intrusion prevention systems (IPS), network segmentation via VLANs, and security audits. We are a Fortinet Registered Partner and our engineers hold Fortinet NSE certifications."}]}]]}],["$","details","3",{"className":"fq-detail","children":[["$","summary",null,{"className":"fq-summary","children":[["$","div",null,{"className":"fq-q-num","children":"04"}],["$","div",null,{"className":"fq-q-text","children":"Can you handle maintenance and support after project completion?"}],["$","div",null,{"className":"fq-chevron","children":["$","i",null,{"className":"bi bi-chevron-down"}]}]]}],["$","div",null,{"className":"fq-answer","children":["$","p",null,{"children":"Absolutely. We offer Annual Maintenance Contracts (AMC) that include scheduled preventive maintenance, helpdesk support via helpdesk.atline.com.my, remote monitoring, and on-site emergency response. Support tiers range from business hours to 24/7 critical support depending on your requirements."}]}]]}],["$","details","4",{"className":"fq-detail","children":[["$","summary",null,{"className":"fq-summary","children":[["$","div",null,{"className":"fq-q-num","children":"05"}],["$","div",null,{"className":"fq-q-text","children":"Do you provide training for our in-house IT team?"}],["$","div",null,{"className":"fq-chevron","children":["$","i",null,{"className":"bi bi-chevron-down"}]}]]}],["$","div",null,{"className":"fq-answer","children":["$","p",null,{"children":"Yes, our Training & Workshop service covers network fundamentals, structured cabling installation and testing, basic network administration, security awareness, and equipment-specific training. Courses are available as on-site workshops, classroom sessions, or customised programmes tailored to your team's skill level."}]}]]}]]}]]}]
