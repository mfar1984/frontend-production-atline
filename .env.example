# ATLINE Website Production Environment
# Domain: https://www.atline.com.my
# App root on the server: /home2/atlineco/public_html/v4

NODE_ENV=production

# Backend API URL, used for SERVER-SIDE rendering only.
# For CLIENT-SIDE requests the browser reads /public/runtime-config.js instead,
# which can be edited on the server without rebuilding.
NEXT_PUBLIC_BACKEND_API_URL=https://sys.atline.com.my

# Shared secret for cache revalidation. MUST match the backend's REVALIDATE_SECRET
# or the admin panel's "clear cache" action is rejected with 401.
REVALIDATE_SECRET=

# Server Configuration
# Passenger supplies PORT itself; HOSTNAME binds to all interfaces so the
# reverse proxy in front can reach it.
PORT=3000
HOSTNAME=0.0.0.0

# IMPORTANT: to change the API URL without rebuilding:
#   1. Edit public/runtime-config.js on the server
#   2. Reload the browser — no restart needed for client-side calls
#   3. Restart only if server-side rendering must pick up a new URL
