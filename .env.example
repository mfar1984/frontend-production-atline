# ============================================
# TEMPLATE ONLY — DO NOT PUT REAL VALUES HERE.
#
# This file IS committed to git. The blank keys below are blank on purpose.
# The real values belong in .env.production on the server, which is ignored
# by git and never leaves the server.
#
# Regenerated by scripts/package-production.js on every run, so anything you
# type here is discarded anyway.
# ============================================
# ATLINE Website Production Environment
# Domain: https://www.atline.com.my
# App root on the server: /home2/atlineco/public_html/v4

NODE_ENV=production

# Backend API URL, used for SERVER-SIDE rendering only.
# For CLIENT-SIDE requests the browser reads /public/runtime-config.js instead,
# which can be edited on the server without rebuilding.
NEXT_PUBLIC_BACKEND_API_URL=https://sys.atline.com.my

# This site's own public URL, used by getWebsiteUrl() in src/lib/runtime-config.ts
# during server-side rendering.
#
# It was missing, and the fallback there is 'http://localhost:3000'. On the server
# that silently produces localhost canonical URLs, sitemap entries and Open Graph
# tags — wrong in a way that renders fine in a browser and only shows up later as
# an SEO problem nobody can trace.
NEXT_PUBLIC_WEBSITE_URL=https://www.atline.com.my

# Shared secret for cache revalidation. MUST match the backend's REVALIDATE_SECRET
# or the admin panel's "clear cache" action is rejected with 401.
REVALIDATE_SECRET=

# Server Configuration
# Passenger supplies PORT itself; HOSTNAME binds to all interfaces so the
# reverse proxy in front can reach it.
PORT=3000
HOSTNAME=0.0.0.0

# IMPORTANT: to change the API URL without rebuilding:
#   1. Edit public/runtime-config.js on the server
#   2. Reload the browser — no restart needed for client-side calls
#   3. Restart only if server-side rendering must pick up a new URL
